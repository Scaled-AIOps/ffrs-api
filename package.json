{
  "name": "ffrs-api",
  "version": "0.1.0",
  "description": "Fast Feedback Response System — capture API (Lambda + Neon)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node esbuild.config.mjs",
    "package": "npm run build && rm -f dist/handler.zip && cd dist && zip -q handler.zip handler.mjs handler.mjs.map",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check": "npm run typecheck && npm test && npm run package"
  },
  "dependencies": {
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@neondatabase/serverless": "^1.0.1",
    "drizzle-orm": "^0.44.4",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/client-sesv2": "^3.1112.0",
    "@aws-sdk/client-ssm": "^3.864.0",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
